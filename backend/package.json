{
  "name": "cafescanner-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "create-scanner": "tsx scripts/create-scanner.ts",
    "promote-owner": "tsx scripts/promote-owner.ts",
    "set-owner-recovery-code": "tsx scripts/set-owner-recovery-code.ts",
    "full-wipe": "tsx scripts/full-wipe.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-session": "^1.18.1",
    "googleapis": "^150.0.1",
    "multer": "^2.4.0",
    "nanoid": "^5.1.5",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.10",
    "prisma": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
