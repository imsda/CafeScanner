DATABASE_URL="file:./prisma/dev.db"
SESSION_SECRET="change-me-super-secret"
PORT=4000
BACKEND_HOST="0.0.0.0"
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Optional settings (uncomment to use)
# Which reverse proxies to trust for client IP / HTTPS detection.
#   unset/loopback = only a proxy on this host (nginx/Traefik on localhost)
#   true = one proxy hop (e.g. Traefik in another container), false = none,
#   or an IP/CIDR list.
# TRUST_PROXY=loopback
# Where in-app backups are written, relative to the repository root.
# BACKUP_DIR=backend/backups
# Google Sheets sync service account (needed only for Google Sheets sync).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
