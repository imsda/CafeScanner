VITE_API_BASE=/api

# Optional dev-server settings (uncomment to use). Keep site-specific values here,
# not in vite.config.ts, so ./scripts/update-service.sh can update cleanly.
# Hostnames the Vite dev server accepts besides localhost/IPs (comma-separated, or "all"):
# FRONTEND_ALLOWED_HOSTS=cafescanner.example.org
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=5173
